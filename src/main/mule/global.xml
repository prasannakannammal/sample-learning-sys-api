    </ee:transform>
</on-error-propagate>
<on-error-propagate type="ANY" doc:name="On Error Propagate - Any">
    <set-variable variableName="httpStatus" doc:name="Set 500 Status"
        value="#[500]"/>

    <ee:transform doc:name="Build Dynamic Error Response">
        <ee:message>
            <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: vars.httpStatus,
    success: false,
    error: {
        source: error.errorType.namespace default "UNKNOWN",
        code: error.errorType.identifier default "UNKNOWN",
        message: error.description default "Unexpected error occurred",
        details: error.detailedDescription default ""
    },
    timestamp: now()
}]]></ee:set-payload>
        </ee:message>
    </ee:transform>
</on-error-propagate>
</error-handler>	
